# Copy to .env and fill in. Never commit .env.
GEMINI_API_KEY=
TMDB_API_KEY=
TAVILY_API_KEY=
# Optional: Reddit official API (script app)
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
# Needed at Launch
# Firebase service account JSON, base64 encoded on one line (server only; never VITE_-prefix it)
FIREBASE_SERVICE_ACCOUNT=
